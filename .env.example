# ============================================================================
# PublishGuard 环境变量模板
# 本地开发请复制为 .env.development（或 .env.local）
# ============================================================================

# 应用与品牌标识
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=PublishGuard
NEXT_PUBLIC_APP_DOMAIN=getpublishguard.com
NEXT_PUBLIC_APP_DESCRIPTION="The Ban-Proof Amazon KDP Publishing & AI Book Studio"
NEXT_PUBLIC_APP_LOGO=/logo.svg
NEXT_PUBLIC_SUPPORT_EMAIL=support@getpublishguard.com
NEXT_PUBLIC_DEFAULT_LOCALE=en

# 数据库（推荐生产与 Worker 模式统一使用 PostgreSQL）
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://publishguard:publishguard@localhost:5432/publishguard
DB_SCHEMA=public
DB_SINGLETON_ENABLED=true
DB_MAX_CONNECTIONS=5

# Better-Auth 密钥（生产环境务必执行 openssl rand -base64 32 生成）
AUTH_URL=http://localhost:3000
AUTH_SECRET=publishguard-dev-secret-change-in-production

# 管理后台敏感配置加密密钥（生产环境必配，32+ 随机字符）
CONFIG_ENCRYPTION_KEY=

# OpenRouter 统一网关与分场景模型路由
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
KDP_OUTLINE_MODEL=google/gemini-2.5-flash
KDP_WRITER_MODEL=anthropic/claude-sonnet-4
KDP_SANITIZER_MODEL=google/gemini-2.5-flash

# Worker 产物本地存储与 Python 执行器路径
KDP_ARTIFACTS_DIR=data/kdp-artifacts
PYTHON_BIN=python3
CHROME_BIN="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

# Stripe / 支付密钥（也可在 /admin/settings 面板中加密保存）
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SIGNING_SECRET=

# 对象存储（Cloudflare R2 / AWS S3）
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_DOMAIN=
